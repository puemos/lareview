 import { db } from "../db";
 import { verifySignature } from "./signature";
 import { applyPayment } from "../orders/applyPayment";
+import { hasReceipt, recordReceipt } from "./receipts";
 
 export async function handleWebhook(request: Request) {
   const event = await verifySignature(request);
-  await db.transaction(async (tx) => {
+
+  if (await hasReceipt(event.id)) {
+    return new Response(null, { status: 204 });
+  }
+
+  await recordReceipt(event.id);
+  void db.transaction(async (tx) => {
     await applyPayment(tx, event);
   });
+
